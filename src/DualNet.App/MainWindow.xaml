<Window x:Class="DualNet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="双网通" Width="1040" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}"
        Icon="Assets/app.ico" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource PageBrush}">
        <Border Margin="14" Background="{DynamicResource DeviceBrush}" BorderBrush="{DynamicResource DeviceBorderBrush}"
                BorderThickness="1" CornerRadius="32" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="92"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource DeviceBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource TextBrush}">
                                <Canvas Width="15" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Line X1="1" Y1="4" X2="5" Y2="4" Stroke="{DynamicResource DeviceBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="1" Y1="10" X2="5" Y2="10" Stroke="{DynamicResource DeviceBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Rectangle Canvas.Left="5" Canvas.Top="4" Width="4" Height="6" Fill="{DynamicResource AccentBrush}"/>
                                    <Line X1="9" Y1="4" X2="14" Y2="4" Stroke="{DynamicResource DeviceBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="9" Y1="10" X2="14" Y2="10" Stroke="{DynamicResource DeviceBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="双网通" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource DeviceTextBrush}"/>
                                <TextBlock Text="{Binding VersionText}" FontSize="9" Foreground="{DynamicResource DeviceMutedBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding RouteStatusColor}" Margin="0,4,7,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="{Binding RouteStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding RouteStatusColor}"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{DynamicResource DeviceMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Height="34" Margin="22,0,10,0" Padding="3" CornerRadius="12" Background="{DynamicResource DeviceSoftBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource ModeRadio}" GroupName="RoutingMode" Content="分流" IsChecked="{Binding IsPartialModeSelected}"/>
                                <RadioButton Style="{StaticResource ModeRadio}" GroupName="RoutingMode" Content="独占" IsChecked="{Binding IsAllModeSelected}"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="4" x:Name="ThemeToggle" Click="OnThemeToggleClick" Style="{StaticResource SecondaryButton}"
                                Padding="10,5" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="18,18,18,0" Height="58" CornerRadius="16" Background="{DynamicResource WarningBannerBrush}"
                        BorderBrush="{DynamicResource WarningBannerBorderBrush}" BorderThickness="1" Padding="14,0"
                        Visibility="{Binding IsConfirmationPending, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource WarningTextBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConfirmationSeconds}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningBannerBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding ConfirmationText}" Foreground="{DynamicResource WarningTextBrush}"
                                   FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"/>
                        <Button Grid.Column="2" Content="保留配置" Command="{Binding KeepConfigurationCommand}" Padding="13,7" VerticalAlignment="Center"/>
                        <Button Grid.Column="4" Content="立即恢复" Command="{Binding RestoreCommand}" Style="{StaticResource DangerOutlineButton}"
                                Padding="12,7" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="28,24">
                        <Grid Visibility="{Binding IsPartialMode, Converter={StaticResource BoolToVisibility}}">
                            <Border Height="470" MaxWidth="930" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    Background="{DynamicResource IslandBrush}" CornerRadius="24" Padding="22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="66"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="指定设备与出口" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource IslandTextBrush}"/>
                                            <TextBlock Text="{Binding RuleInputHint}" FontSize="8.5" Foreground="{DynamicResource IslandMutedBrush}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="510" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62"/><ColumnDefinition Width="7"/><ColumnDefinition Width="62"/><ColumnDefinition Width="7"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="54"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="RuleKind" Content="设备" IsChecked="{Binding IsHostRuleKind}"/>
                                            <RadioButton Grid.Column="2" Style="{StaticResource SegmentRadio}" GroupName="RuleKind" Content="网段" IsChecked="{Binding IsSubnetRuleKind}"/>
                                            <TextBox Grid.Column="4" Text="{Binding RuleInput, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5" FontSize="11"/>
                                            <Button Grid.Column="6" Content="添加" Command="{Binding AddRuleCommand}" Style="{StaticResource AccentButton}" Height="34" Padding="7,5" FontSize="10.5"/>
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/><ColumnDefinition Width="22"/><ColumnDefinition Width=".85*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Rules}" VerticalAlignment="Stretch">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MinHeight="150" Margin="0,0,0,12" Background="{DynamicResource KeyBrush}" CornerRadius="16" Padding="16">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" Margin="0,4,6,0" VerticalAlignment="Top"/>
                                                                        <TextBlock Text="{Binding KindLabel}" FontSize="9" Foreground="{DynamicResource IslandMutedBrush}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Target}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource IslandTextBrush}" Margin="0,8,0,0"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                        <TextBlock Text="本机" FontSize="9" Foreground="{DynamicResource IslandMutedBrush}" VerticalAlignment="Center"/>
                                                                        <TextBox Text="{Binding LocalAddress, UpdateSourceTrigger=PropertyChanged}" Width="132" Height="26" Padding="6,3" FontSize="9.5" Margin="6,0,0,0"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor}" Margin="0,8,0,0"/>
                                                                    <TextBlock Text="{Binding StatusDetail}" FontSize="8.5" Foreground="{DynamicResource IslandMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                    <TextBlock Text="{Binding CoveredText}" FontSize="8.5" Foreground="{DynamicResource WarningBannerBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="×" Style="{StaticResource GhostButton}" FontSize="15" VerticalAlignment="Top"
                                                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Border Grid.RowSpan="2" Background="{DynamicResource KeyBrush}" CornerRadius="16" Padding="18"
                                                    Visibility="{Binding HasRules, Converter={StaticResource InverseBoolToVisibility}}" VerticalAlignment="Center">
                                                <TextBlock Text="尚未添加目标" FontSize="11" Foreground="{DynamicResource IslandMutedBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Background="{DynamicResource ModuleBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
                                                    CornerRadius="16" Padding="15">
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="目标网卡" FontSize="9" Foreground="{DynamicResource IslandMutedBrush}"/>
                                                        <Ellipse Width="6" Height="6" Fill="{Binding TargetStatusColor}" Margin="8,4,0,0"/>
                                                    </StackPanel>
                                                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedTarget}" Height="40" Margin="0,11,0,0"
                                                              ItemTemplate="{StaticResource AdapterItemTemplate}">
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding TargetStatus}" FontSize="9.5" Foreground="{Binding TargetStatusColor}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="2" Background="{DynamicResource ModuleBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
                                                    CornerRadius="16" Padding="15">
                                                <StackPanel VerticalAlignment="Center">
                                                    <CheckBox Content="指定出口（可选）" IsChecked="{Binding UseInternetAdapter}" Margin="0,0,0,11"/>
                                                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedInternetAdapter}" IsEnabled="{Binding UseInternetAdapter}" Height="40"
                                                              ItemTemplate="{StaticResource AdapterItemTemplate}">
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding InternetAdapterHint}" FontSize="8.5" Foreground="{DynamicResource IslandMutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding IsAllMode, Converter={StaticResource BoolToVisibility}}">
                            <Border Height="464" MaxWidth="930" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    Background="{DynamicResource IslandBrush}" CornerRadius="24" Padding="22">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="112"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="250"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="全部流量" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource IslandTextBrush}" Margin="0,6,0,0"/>
                                            <TextBlock Text="其他可见网卡会暂时关闭。" FontSize="9.5" Foreground="{DynamicResource IslandMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBannerBrush}" Margin="0,4,6,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="高风险 · 60 秒监护" FontSize="9.5" Foreground="{DynamicResource WarningBannerBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="本机 IPv4" Style="{StaticResource SectionLabel}"/><TextBox Text="{Binding AllLocalAddress, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="9,7" FontSize="11.5"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="前缀" Style="{StaticResource SectionLabel}"/><TextBox Text="{Binding AllPrefixLength, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="9,7" FontSize="11.5"/></StackPanel>
                                            <StackPanel Grid.Row="2"><TextBlock Text="路由器地址" Style="{StaticResource SectionLabel}"/><TextBox Text="{Binding AllGateway, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="9,7" FontSize="11.5"/></StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="可选 DNS" Style="{StaticResource SectionLabel}"/><TextBox Text="{Binding AllDns, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="9,7" FontSize="11.5"/></StackPanel>
                                        </Grid>

                                        <Border Grid.Column="4" Background="{DynamicResource ModuleBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="15">
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="独占网卡" FontSize="9" Foreground="{DynamicResource IslandMutedBrush}"/>
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBannerBrush}" Margin="8,4,0,0"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedTarget}" Height="40" Margin="0,11,0,0"
                                                          ItemTemplate="{StaticResource AdapterItemTemplate}">
                                                </ComboBox>
                                                <TextBlock Text="其他可见网卡将暂时关闭" FontSize="9" Foreground="{DynamicResource IslandMutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource ModuleBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="15">
                                            <StackPanel><TextBlock Text="影响范围" Style="{StaticResource IslandMicroLabel}"/><TextBlock Text="所有 IPv4 / IPv6 流量" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource IslandTextBrush}" Margin="0,8,0,0"/><TextBlock Text="只走当前选择的独占网卡。" FontSize="9" Foreground="{DynamicResource IslandMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource ModuleBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="15">
                                            <StackPanel><TextBlock Text="自动保护" Style="{StaticResource IslandMicroLabel}"/><TextBlock Text="60 秒自动恢复" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource IslandTextBrush}" Margin="0,8,0,0"/><TextBlock Text="超时未确认时恢复基线网络。" FontSize="9" Foreground="{DynamicResource IslandMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Background="{DynamicResource ModuleBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="15">
                                            <StackPanel><TextBlock Text="恢复路径" Style="{StaticResource IslandMicroLabel}"/><TextBlock Text="随时恢复原网络" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource IslandTextBrush}" Margin="0,8,0,0"/><TextBlock Text="失败会尝试回滚，恢复入口始终可用。" FontSize="9" Foreground="{DynamicResource IslandMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="3" BorderBrush="{DynamicResource DeviceBorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsPartialMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DeviceTextBrush}">
                                <Run Text="{Binding Rules.Count, Mode=OneWay}" FontFamily="Consolas"/><Run Text=" 条目标规则"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="其余 IPv4 流量继续使用原出口" FontSize="9" Foreground="{DynamicResource DeviceMutedBrush}"/>
                                <ProgressBar Width="80" Margin="10,3,0,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsAllMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="严格模式 · 60 秒自动保护" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DeviceTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="超时未确认会恢复原网络" FontSize="9" Foreground="{DynamicResource DeviceMutedBrush}"/>
                                <ProgressBar Width="80" Margin="10,3,0,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="刷新网络" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="40" Padding="15,7" Margin="0,0,9,0"/>
                            <Button Content="{Binding PrimaryActionText}" Command="{Binding ApplyCommand}" Height="40" Padding="22,7"/>
                            <Button Content="恢复原网络" Command="{Binding RestoreCommand}" Style="{StaticResource DangerOutlineButton}" Height="40" Padding="16,7" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
