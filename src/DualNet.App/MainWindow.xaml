<Window x:Class="DualNet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="双网通" Width="1040" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}"
        Icon="Assets/app.ico" FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,18">
                    <Border Width="42" Height="42" Background="#EAF8F7" CornerRadius="10" Padding="5">
                        <Image Source="{StaticResource BrandLogo}" Stretch="Uniform" SnapsToDevicePixels="True"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="双网通" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,0,20,12">
                        <TextBlock Text="路由方式" Style="{StaticResource SectionLabel}"/>
                        <RadioButton Style="{StaticResource ModeCardRadio}" GroupName="RoutingMode" IsChecked="{Binding IsPartialModeSelected}">
                            <StackPanel>
                                <TextBlock Text="部分流量" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="只有指定 IP 或网段走目标网卡" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ModeCardRadio}" GroupName="RoutingMode" IsChecked="{Binding IsAllModeSelected}" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="全部流量" FontSize="14" FontWeight="SemiBold"/>
                                    <Border Grid.Column="1" Background="{DynamicResource DangerSoftBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="高风险" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="临时关闭其他网卡，应用后须 60 秒内确认" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="目标网卡" Style="{StaticResource SectionLabel}" Margin="0,20,0,2"/>
                        <TextBlock Text="设备与规则流量走这张网卡" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedTarget}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding TargetStatusColor}" Margin="0,3,7,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding TargetStatus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Margin="0,18,0,0" Padding="12" Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9"
                                Visibility="{Binding IsPartialMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <CheckBox Content="指定上网网卡（可选）" IsChecked="{Binding UseInternetAdapter}" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedInternetAdapter}"
                                          IsEnabled="{Binding UseInternetAdapter}" Margin="0,8,0,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding InternetAdapterHint}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="1,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="20,10,20,16">
                    <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="11,9" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding RouteStatusColor}" Margin="0,3,7,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding RouteStatus}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="刷新网络" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="2" x:Name="ThemeToggle" Click="OnThemeToggleClick" Style="{StaticResource SecondaryButton}" Padding="12,9"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧主区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource WarningBannerBrush}" BorderBrush="{DynamicResource WarningBannerBorderBrush}"
                    BorderThickness="0,0,0,1.5" Padding="24,14"
                    Visibility="{Binding IsConfirmationPending, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" CornerRadius="29" Background="{DynamicResource WarningBannerBorderBrush}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConfirmationSeconds}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding ConfirmationText}" Foreground="{DynamicResource WarningTextBrush}"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Grid.Column="2" Content="保留此配置" Command="{Binding KeepConfigurationCommand}" FontSize="14" FontWeight="SemiBold" Padding="20,10" VerticalAlignment="Center"/>
                    <Button Grid.Column="4" Content="立即恢复" Command="{Binding RestoreCommand}" Style="{StaticResource DangerOutlineButton}" FontSize="14" Padding="18,10" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="860">

                    <Border Style="{StaticResource Card}" Visibility="{Binding IsPartialMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="分流目标" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="添加单个设备 IP 或整个网段；已有同网段地址会直接复用，缺少时才自动补充 .200/24"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                            <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="RuleKind" Content="单个设备 IP" IsChecked="{Binding IsHostRuleKind}"/>
                                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="RuleKind" Content="整个网段" IsChecked="{Binding IsSubnetRuleKind}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="2" Text="{Binding RuleInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="4" Content="添加目标" Command="{Binding AddRuleCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding RuleInputHint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="26,22"
                                    Visibility="{Binding HasRules, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="还没有分流目标" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="在上方输入设备 IP 或网段，点击“添加目标”" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.RowSpan="2" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}"/>
                                                </Border>
                                                <TextBlock Grid.RowSpan="2" Grid.Column="2" Text="{Binding Target}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="4" Grid.Row="0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,4,6,0" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </Grid>
                                                <StackPanel Grid.Column="4" Grid.Row="1" Margin="14,2,0,0">
                                                    <TextBlock Text="{Binding StatusDetail}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding CoveredText}" FontSize="10.5" Foreground="#C08A2D" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.RowSpan="2" Grid.Column="6" VerticalAlignment="Center">
                                                    <TextBlock Text="本机地址（可修改）" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,3"/>
                                                    <TextBox Text="{Binding LocalAddress, UpdateSourceTrigger=PropertyChanged}" Padding="7,5" FontSize="12.5"/>
                                                </StackPanel>
                                                <Button Grid.RowSpan="2" Grid.Column="8" Content="移除" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding IsAllMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="全部流量（严格模式）" FontSize="17" FontWeight="SemiBold"/>
                                <Border Grid.Column="1" Background="{DynamicResource DangerSoftBrush}" CornerRadius="4" Padding="7,2"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                    <TextBlock Text="高风险" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="已有参数会自动带出；应用后将暂时关闭其他可见网卡的 IPv4 和 IPv6"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="本机 IPv4" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding AllLocalAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="前缀" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding AllPrefixLength, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="路由器地址" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding AllGateway, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="可选 DNS（多个地址用逗号分隔）" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,5"/>
                            <TextBox Text="{Binding AllDns, UpdateSourceTrigger=PropertyChanged}"/>
                            <Border Background="{DynamicResource WarningBannerBrush}" BorderBrush="{DynamicResource WarningBannerBorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="13,11" Margin="0,14,0,0">
                                <TextBlock Text="此模式只保证流量不从其他网卡绕行，不保证目标网卡能够访问互联网。应用后必须在 60 秒内确认。"
                                           Foreground="{DynamicResource WarningTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,0,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,6,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding PrimaryActionText}" Command="{Binding ApplyCommand}" FontSize="15" FontWeight="SemiBold" Padding="22,11"/>
                    <Button Grid.Column="4" Content="恢复原网络" Command="{Binding RestoreCommand}" Style="{StaticResource DangerOutlineButton}"
                            FontSize="14" FontWeight="SemiBold" Padding="18,11"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
